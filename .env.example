# ==============================================================================
# HORIZON ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Core Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production_to_a_secure_random_string_32_chars_min

# Authoritative Backend API (Python / FastAPI)
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# Database (PostgreSQL + PostGIS)
# Default for Docker Compose is port 5432
DATABASE_URL=postgresql://horizon_user:horizon_password@localhost:5432/horizon_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AI / ML Verification Microservice (Python / FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_API_KEY=horizon_ai_dev_key

# S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / Local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=horizon-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Token Economy & Platform Rules
STARTER_TOKEN_GRANT=100
DEFAULT_TASK_EXPIRATION_HOURS=24
MINIMUM_COMMITMENT_STAKE=10

# Next.js Reviewer & Admin Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Downstream Geospatial Pipeline (Loupe Ingest)
LOUPE_PIPELINE_ENDPOINT=https://pipeline.loupe.internal/ingest
LOUPE_API_KEY=
