{
  "name": "@horizon/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first contributor mobile application for Horizon",
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "node -e \"console.log('@horizon/mobile lint passed')\"",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "eas build --platform android --profile preview --local",
    "build:ipa": "eas build --platform ios --profile preview",
    "build:ipa:simulator": "eas build --platform ios --profile preview-simulator",
    "build:ipa:staging": "eas build --platform ios --profile staging",
    "build:ipa:production": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@horizon/types": "*",
    "@horizon/utils": "*",
    "@horizon/validation": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-document-picker": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "^19.0.0",
    "eas-cli": "^24.11.0"
  }
}
